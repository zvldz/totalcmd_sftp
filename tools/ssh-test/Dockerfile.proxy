# Proxies in front of the test SSH server, for the plugin's proxy modes:
#   1080  SOCKS5, no authentication           (microsocks)
#   1081  SOCKS5, user proxyuser / proxypass  (microsocks)
#   8888  HTTP CONNECT                         (tinyproxy)
FROM debian:stable-slim

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        microsocks tinyproxy \
 && rm -rf /var/lib/apt/lists/*

COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
COPY proxy-entrypoint.sh /proxy-entrypoint.sh
RUN chmod 755 /proxy-entrypoint.sh

EXPOSE 1080 1081 8888
ENTRYPOINT ["/proxy-entrypoint.sh"]
